{
  "name": "relay-gateway",
  "version": "0.1.0",
  "description": "Self-hostable multi-tenant Telegram messaging platform: each of your customers connects their own Telegram bot, and you message their end-users through one API, one webhook, and one MCP server.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": {
    "name": "Arif",
    "url": "https://github.com/arif-js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arif-js/relay-gateway.git"
  },
  "homepage": "https://github.com/arif-js/relay-gateway#readme",
  "bugs": {
    "url": "https://github.com/arif-js/relay-gateway/issues"
  },
  "bin": {
    "relay-gateway": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "keywords": [
    "telegram",
    "telegram-bot",
    "messaging",
    "multi-tenant",
    "webhooks",
    "model-context-protocol",
    "mcp",
    "ai-agents",
    "self-hosted",
    "open-source",
    "bot",
    "whatsapp-alternative",
    "saas"
  ],
  "scripts": {
    "build": "vite build && node scripts/gen-assets.mjs && tsup",
    "build:client": "vite build",
    "dev": "vite build && node scripts/gen-assets.mjs && RELAY_DEMO=1 tsx src/cli.ts serve",
    "pretest": "vite build && node scripts/gen-assets.mjs",
    "start": "node dist/cli.js serve",
    "typecheck": "node scripts/gen-assets.mjs && tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect": "npx @modelcontextprotocol/inspector node dist/mcp.js"
  },
  "dependencies": {
    "@clerk/backend": "^3.26.2",
    "@clerk/clerk-react": "^5.61.11",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "libsql": "0.5.29",
    "lucide-react": "^0.525.0",
    "raditail": "^0.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.7.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "tsup": "8.5.1",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vite": "^8.3.5",
    "vitest": "5.0.4"
  }
}
