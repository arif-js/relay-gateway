# Copy to relay.env and edit. Never commit the real file.
#
#   cp relay.env.example relay.env
#
# The only value you must set is RELAY_PUBLIC_URL: it is the address your
# customers see in their connect links, and Telegram must be able to reach
# your webhook.

# The public address of this deployment. Must be HTTPS in production.
RELAY_PUBLIC_URL=https://relay.example.com

# The platform key (L2 -> L1). Generate one:
#   node -e "console.log('rg_admin_' + require('crypto').randomBytes(24).toString('base64url'))"
RELAY_ADMIN_KEY=rg_admin_change_me

# 32 bytes, hex or base64. Losing it means losing every stored bot token.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
RELAY_ENCRYPTION_KEY=change_me

# The manager bot that creates and holds the managed bots.
# Enable "Bot Management Mode" in @BotFather.
RELAY_MANAGER_BOT_TOKEN=123456:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RELAY_MANAGER_BOT_USERNAME=your_manager_bot

# The secret Telegram sends in X-Telegram-Bot-Api-Secret-Token.
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
RELAY_TELEGRAM_WEBHOOK_SECRET=change_me

# Where the SQLite file lives. The docker-compose volume is mounted here.
RELAY_DATA_DIR=/data

# The bind address inside the container. The compose file maps it to
# 127.0.0.1 on the host, so a reverse proxy is the only thing that can reach it.
RELAY_HOST=0.0.0.0
RELAY_PORT=8787

# selfhost = no ceilings. hosted = 3 tenants, 2,000 messages/month, 5 webhooks.
RELAY_PLAN=hosted

RELAY_LOG_LEVEL=info

# A remote database instead of the local file. Leave empty for the local file.
# Set it to a Turso (libSQL) URL on a serverless host.
# RELAY_DATABASE_URL=libsql://your-db.turso.io
# RELAY_DATABASE_AUTH_TOKEN=your-token
