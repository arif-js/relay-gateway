# ─────────────────────────────────────────────────────────────────────────────
# relay-gateway — copy to .env and edit. Never commit the real file.
# ─────────────────────────────────────────────────────────────────────────────

# Where the SQLite file, the admin key and the encryption key live.
RELAY_DATA_DIR=~/.relay-gateway

# HTTP bind address and port.
RELAY_HOST=127.0.0.1
RELAY_PORT=8787

# The base URL customers see in their connect links. Must be reachable by them.
RELAY_PUBLIC_URL=http://localhost:8787

# A remote database (Turso / libSQL). Leave empty for the local SQLite file.
# Set it on a serverless host, where there is no disk to keep a file on.
# RELAY_DATABASE_URL=libsql://your-db.turso.io
# RELAY_DATABASE_AUTH_TOKEN=your-token

# The platform key (L2 -> L1). Generated and persisted if unset.
# RELAY_ADMIN_KEY=rg_admin_...

# The manager bot that creates and holds the managed bots.
# Enable "Bot Management Mode" (and "Secretary Mode" for Mode B) in @BotFather.
# RELAY_MANAGER_BOT_TOKEN=123456:AA...
# RELAY_MANAGER_BOT_USERNAME=your_manager_bot

# The secret Telegram sends in X-Telegram-Bot-Api-Secret-Token. Generated if unset.
# RELAY_TELEGRAM_WEBHOOK_SECRET=...

# 32 bytes, hex or base64. Losing it means losing every stored bot token.
# RELAY_ENCRYPTION_KEY=...

# Use the in-process fake Telegram client. Nothing leaves the machine.
RELAY_DEMO=0

# selfhost = no ceilings. hosted = 3 tenants, 2000 messages/month, 5 webhooks.
RELAY_PLAN=selfhost

# debug | info | warn | error
RELAY_LOG_LEVEL=info
